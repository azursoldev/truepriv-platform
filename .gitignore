# Root .gitignore for DPODPCO Platform
# Nigeria Data Protection Act (NDPA 2023) Compliance SaaS

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary tools & downloads
tools/node.zip
tools/
cloudflared.exe
*.mp4
tunnel_url.txt
test_login.json

# Backend
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/storage/*.key
backend/storage/app/tenants/*
!backend/storage/app/tenants/.gitignore
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*.php
backend/.phpunit.result.cache

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Database & SQLite files
*.sqlite
*.sqlite-journal
