						"body": {
							"mode": "raw",
							"raw": "{\n    \"organization_name\": \"Sterling Health Services Ltd\",\n    \"tenant_type\": \"corporate\",\n    \"industry_slug\": \"healthcare-hmo\",\n    \"rc_number\": \"RC-984210\",\n    \"name\": \"Dr. Wale Johnson\",\n    \"email\": \"compliance@sterlinghealth.ng\",\n    \"password\": \"Password@123\",\n    \"state\": \"Lagos\",\n    \"auto_populate_ropa\": true\n}"
